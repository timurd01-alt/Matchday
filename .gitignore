# never publish credentials or personal data
config_keys.py
config_keys*.py

# Build payloads and provider caches: regenerated every run, CI-cache-owned.
# A tracked copy would be checked out over the restored cache.
data.json
data_*.json
odds_open*.json
title_open*.json
*_cache.json
odds_market_cache_*.json
outrights_market_cache_*.json
player_db_*.json

# Local runtime state, regenerated and never authored.
.browser-profile/
__pycache__/
*.pyc
.ci_fetch_state.json
provider_quota_state.json
fetch_failure_*.json
fixture_count_history.json
automation/logs/
_site/
node_modules/

# Derived reports, regenerated each run.
next_task.json
ui_audit_report.json
data_coverage_report.json
advanced_metrics_*.json

# Rendered exports from the social/index.html graphics tool; social/logos/
# stays tracked -- this only matches the folder root.
/social/*.png

# Retired 2026-09-13 / 2026-09-25 (other sports; the in-house model, its
# ratings, pick ledgers, challengers and research reports). Nothing reads
# these any more. Kept ignored so a stale local copy is never committed or
# mistaken for live data -- the graded record lives in trdlab_picks.json.
ratings*.json
picks_log*.json
forecast_ledger_*.jsonl
*_challenger_*.json
*_challenger_*.jsonl
*_prospective_scorecard.json
nfl_*
mlb_*
nflverse_*
market_benchmark_report.json
baseline_tournament_report.json
clv_report.json
independent_value_report.json
research_posts.json
posts/research-*.html
.x_bot_state.json
promotion_readiness.json
